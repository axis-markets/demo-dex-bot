# Required: secret key (S...) of the bot's Stellar account
TRADER_SECRET=S...your-testnet-secret...

# Optional: which <name>.config.json to load from the project root (default: testnet)
# CONFIG_NAME=testnet

# Optional: AXIS aggregator/indexer API origin, overrides `indexerUrl` of the config file
# INDEXER_URL=http://localhost:8070
